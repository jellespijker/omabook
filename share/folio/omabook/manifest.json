{
  "folio": 1,
  "requires": [
    "omabook"
  ],
  "poll": {
    "command": [
      "omabook",
      "folio",
      "libraries"
    ],
    "every": 5
  },
  "section": {
    "title": "Libraries"
  },
  "actions": [
    {
      "id": "open",
      "label": "Open in Omabook",
      "command": [
        "omabook",
        "folio",
        "open"
      ],
      "types": [
        "application/epub+zip",
        "application/pdf",
        "application/x-fictionbook+xml",
        "application/x-zip-compressed-fb2",
        "application/vnd.comicbook+zip",
        "application/vnd.comicbook-rar",
        "application/x-cb7",
        "application/x-cbt",
        "application/x-mobipocket-ebook",
        "application/x-mobi8-ebook",
        "application/vnd.amazon.mobi8-ebook",
        "application/vnd.amazon.ebook",
        "application/x-sony-bbeb",
        "image/vnd.djvu",
        "image/vnd.djvu+multipage",
        "text/markdown",
        "application/x-markdown-book"
      ],
      "files": true,
      "single": true,
      "busy": "Opening %1…"
    },
    {
      "id": "lookup",
      "label": "Look Up Details",
      "command": [
        "omabook",
        "folio",
        "lookup"
      ],
      "under": [
        "~/.local/state/omabook/folio/"
      ],
      "files": true,
      "single": true
    },
    {
      "id": "read",
      "label": "Mark as Read",
      "command": [
        "omabook",
        "folio",
        "mark",
        "read"
      ],
      "under": [
        "~/.local/state/omabook/folio/"
      ],
      "files": true
    },
    {
      "id": "reading",
      "label": "Mark as Reading",
      "command": [
        "omabook",
        "folio",
        "mark",
        "reading"
      ],
      "under": [
        "~/.local/state/omabook/folio/"
      ],
      "files": true
    },
    {
      "id": "remove",
      "label": "Remove from Library",
      "command": [
        "omabook",
        "folio",
        "remove"
      ],
      "under": [
        "~/.local/state/omabook/folio/"
      ],
      "files": true,
      "busy": "Moving %1 to the trash…"
    },
    {
      "id": "add",
      "label": "Add to Library",
      "to": "items",
      "command": [
        "omabook",
        "folio",
        "add"
      ],
      "types": [
        "application/epub+zip",
        "application/pdf",
        "application/x-fictionbook+xml",
        "application/x-zip-compressed-fb2",
        "application/vnd.comicbook+zip",
        "application/vnd.comicbook-rar",
        "application/x-cb7",
        "application/x-cbt",
        "application/x-mobipocket-ebook",
        "application/x-mobi8-ebook",
        "application/vnd.amazon.mobi8-ebook",
        "application/vnd.amazon.ebook",
        "application/x-sony-bbeb",
        "image/vnd.djvu",
        "image/vnd.djvu+multipage",
        "text/markdown",
        "application/x-markdown-book",
        "inode/directory"
      ],
      "busy": "Adding to %1…"
    }
  ],
  "details": {
    "command": [
      "omabook",
      "folio",
      "details"
    ],
    "types": [
      "application/epub+zip",
      "application/pdf",
      "application/x-fictionbook+xml",
      "application/x-zip-compressed-fb2",
      "application/vnd.comicbook+zip",
      "application/vnd.comicbook-rar",
      "application/x-cb7",
      "application/x-cbt",
      "application/x-mobipocket-ebook",
      "application/x-mobi8-ebook",
      "application/vnd.amazon.mobi8-ebook",
      "application/vnd.amazon.ebook",
      "application/x-sony-bbeb",
      "image/vnd.djvu",
      "image/vnd.djvu+multipage",
      "text/markdown",
      "application/x-markdown-book"
    ]
  }
}
