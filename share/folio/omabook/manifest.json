{
  "folio": 1,
  "requires": [
    "omabook"
  ],
  "poll": {
    "command": [
      "omabook",
      "folio",
      "libraries"
    ],
    "every": 60
  },
  "section": {
    "title": "Libraries"
  },
  "actions": [
    {
      "id": "add",
      "label": "Add to Library",
      "to": "items",
      "command": [
        "omabook",
        "folio",
        "add"
      ],
      "types": [
        "application/epub+zip",
        "application/pdf",
        "application/x-fictionbook+xml",
        "application/vnd.comicbook+zip",
        "application/vnd.comicbook-rar",
        "application/x-mobipocket-ebook",
        "application/vnd.amazon.ebook",
        "image/vnd.djvu",
        "inode/directory"
      ],
      "busy": "Adding to %1\u2026"
    }
  ],
  "details": {
    "command": [
      "omabook",
      "folio",
      "details"
    ],
    "types": [
      "application/epub+zip",
      "application/pdf",
      "application/x-fictionbook+xml",
      "application/vnd.comicbook+zip",
      "application/vnd.comicbook-rar",
      "application/x-mobipocket-ebook",
      "application/vnd.amazon.ebook",
      "image/vnd.djvu"
    ]
  }
}
