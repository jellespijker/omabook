# The hub (#179): Omabook without a window, always on, as the one writer to
# the libraries it keeps (ADR 0013). This variant runs as a person's own user:
#
#   omabook hub run --libraries ~/Hub     once, in a terminal, to choose the folder (Ctrl+C after)
#   systemctl --user enable --now omabook-hub
#   loginctl enable-linger                so that it runs with no one logged in
#
# Its state is in ~/.local/state/omabook-hub, its socket in
# $XDG_RUNTIME_DIR/omabook-hub, and what it says in the journal
# (journalctl --user -u omabook-hub). Its secrets are systemd credentials
# named omabook-hub.<name> (systemd-creds encrypt --user), or 0600 files in
# its state's secrets folder; never a keyring.
[Unit]
Description=Omabook hub: libraries kept without a window, always on
After=network-online.target

[Service]
Type=exec
ExecStart="@omabook_installed@" hub run
# Back whenever it stops, unless it isn't set up (no folder for its libraries).
Restart=always
RestartSec=5
RestartPreventExitStatus=78
StateDirectory=omabook-hub
StateDirectoryMode=0700
RuntimeDirectory=omabook-hub
RuntimeDirectoryMode=0700
ImportCredential=omabook-hub.*
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
